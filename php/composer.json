{
    "name": "apiverve/articleideas",
    "description": "Article Ideas Generator creates article ideas and headline angles for any supplied topic. Pass a keyword up to 50 characters to receive a list of suggested titles and the total idea count.",
    "version": "1.2.2",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "articleideas",
        "article ideas api",
        "generate article ideas",
        "blog post ideas",
        "headline generator",
        "content topic brainstorming"
    ],
    "homepage": "https://apiverve.com/marketplace/articleideas?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/articleideas",
        "source": "https://github.com/apiverve/articleideas-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Articleideas\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Articleideas\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
